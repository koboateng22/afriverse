# ─────────────────────────────────────────────────────────────
# Afriversity environment variables — every variable the app uses.
# ─────────────────────────────────────────────────────────────

# ── CLIENT (Vite) — public, bundled into the browser ──────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
# Optional analytics (public key)
VITE_POSTHOG_KEY=

# ── SERVER — Supabase Edge Function secrets. NEVER prefix with VITE_. ──
# Set with:  npx supabase secrets set NAME=value
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
#  into edge functions automatically on hosted Supabase.)
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=
YOUTUBE_API_KEY=
RESEND_API_KEY=

# ── SERVER — optional ──
# Where Paystack sends students back after checkout (comma-separate several).
SITE_URL=https://your-domain.com
# Override the Groq model without a code change (default: llama-3.3-70b-versatile,
# falling back to openai/gpt-oss-120b if Groq rejects it as retired).
GROQ_MODEL=
# Vision model for the WASSCE result-slip scanner (scan-results). Default: qwen/qwen3.8-27b.
GROQ_VISION_MODEL=
# Verified sender for renewal emails (default: Afriversity <onboarding@resend.dev>).
RESEND_FROM=

# ── SERVER — test-only overrides (leave unset in production) ──
# Point Groq at a local OpenAI-compatible server in CI (default: https://api.groq.com/openai/v1).
GROQ_API_BASE=
# Point Paystack at a local compatible server in CI. Ignored unless the key is sk_test_….
PAYSTACK_API_BASE=
